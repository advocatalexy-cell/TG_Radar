[Unit]
Description=Radar parallel Codex analysis through ChatGPT subscription
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=radar-analysis
Group=radar-analysis
WorkingDirectory=/var/lib/radar-codex
Environment=HOME=/var/lib/radar-codex
Environment=CODEX_HOME=/var/lib/radar-codex/.codex
Environment=PATH=/var/lib/radar-codex/.local/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY OPENAI_BASE_URL TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_SESSION_STRING
ExecStart=/usr/bin/python3 /usr/local/lib/radar/run-subscription-analysis.py analyze
TimeoutStartSec=170min
KillMode=control-group
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/radar-codex
InaccessiblePaths=/opt/radar /root
PrivateTmp=true
